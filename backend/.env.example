# =====================================================================================
# KnowFlow 配置样例。复制成 backend/.env 后按需修改。
#
#   复制：  cp backend/.env.example .env          （Windows: Copy-Item）
#   位置：  backend/.env   或  仓库根目录的 .env  （两个位置都读，前者优先）
#
# 读这一份等于读配置文档：每一项都写了"默认值 / 什么时候要改 / 改了会怎样"。
# 所有键的唯一权威定义在 backend/src/knowflow/core/config.py。
# =====================================================================================

# ------------------------------------ 应用 ------------------------------------
APP_NAME=KnowFlow
APP_VERSION=1.0.0
# dev / prod / test。prod 下会强制要求 JWT_SECRET 且禁止 DEBUG
ENV=dev
DEBUG=true
HOST=127.0.0.1
PORT=8000
API_PREFIX=/api/v1

# CORS 两种写法都支持：
#   CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
#   CORS_ORIGINS=["http://localhost:5173"]
# ⚠ 只有 JSON 写法会走 pydantic 默认解析；逗号写法由自定义校验器处理（已测通）。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -------------------------------- 数据与数据库 --------------------------------
# 运行期数据根目录（上传原文件 / 向量库 / checkpointer / 样例 / 评测集都在这下面）
# 默认是仓库根的 data/，留空即可
# DATA_DIR=

# MySQL 8。库要先建好：CREATE DATABASE knowflow DEFAULT CHARSET utf8mb4;
DATABASE_URL=mysql+pymysql://root:1234@127.0.0.1:3306/knowflow?charset=utf8mb4
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# ------------------------------------ 认证 ------------------------------------
# ⚠ 生产环境必须改成一个足够长的随机串（HS256 建议 >= 32 字节）
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------------------------------- 对话模型 ----------------------------------
# 留空 = 离线模式（不调任何外部服务，用抽取式回答，链路完整可演示、CI 零成本）
OPENAI_API_KEY=
# 换供应商只改这一行：DeepSeek / 通义 / 智谱 / vLLM / Ollama 都提供 OpenAI 兼容端点
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2
# 判官模型（grade / reflect / 评测打分）。留空 = 复用上面的主模型。
# 建议配一个便宜的小模型：判官调用次数远多于主生成。
LLM_JUDGE_MODEL=

# ---------------------------------- 向量化 ------------------------------------
# local = 本地 BGE-M3（默认，零 API 成本、离线可复现）
# hash  = 确定性哈希向量兜底，无语义能力，只用于让 CI/演示零依赖跑通
# api   = 远程 OpenAI 兼容 /embeddings 接口
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
# 指向本地模型目录可完全离线（优先级最高）。填 HF 原生缓存里的 snapshots/<sha> 目录
# EMBEDDING_MODEL_PATH=D:\path\to\models--BAAI--bge-m3\snapshots\<sha>
EMBEDDING_MODEL_PATH=
# auto = 有 CUDA 用 GPU，否则 CPU
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=16
# ⚠ 与模型强绑定。换模型（维度变了）必须重建整个向量库
EMBEDDING_DIM=1024
# 仅 EMBEDDING_PROVIDER=api 时需要
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# ---------------------------------- 向量库 ------------------------------------
# chroma = 本地文件型（默认，零运维）; memory = 纯内存（测试用）
VECTOR_BACKEND=chroma

# ------------------------- 相关性闸门阈值（标定值，勿随意改） -------------------------
# 实测 BGE-M3 上"无关文本"的相似度基线约 0.57（不是 0），所以阈值必须标定。
# 重新标定： python backend/scripts/calibrate_threshold.py --out data/threshold_calibration.json
VECTOR_MIN_SCORE=0.60
KEYWORD_MIN_COVERAGE=0.40

# ------------------------------------ 切分 ------------------------------------
# ⚠ 必须满足 CHUNK_OVERLAP < CHUNK_SIZE，否则启动即报错（递归切分器无法收敛）
CHUNK_SIZE=600
CHUNK_OVERLAP=120
# 小于此长度的碎片会被合并到上一块
CHUNK_MIN_CHARS=80
# 父块（喂给模型的单位，比子块大，保证上下文完整）
PARENT_CHUNK_SIZE=1800

# ------------------------------------ 检索 ------------------------------------
TOP_K=5
FETCH_K=20
# rrf = 倒数排名融合（默认，对分数尺度漂移免疫）; weighted = 归一化加权
FUSION=rrf
# 仅 FUSION=weighted 时生效：向量权重
ALPHA=0.6
RRF_K=60
RERANK_ENABLED=true
RERANK_TOP_N=10
AUTOCUT_ENABLED=true
AUTOCUT_RATIO=0.35
MAX_CONTEXT_CHARS=8000

# ------------------------------ Agent（LangGraph） ------------------------------
# 召回不足时最多改写几次查询（防止死循环烧钱）
AGENT_MAX_REWRITE=2
# 答案引用校验不通过时最多重新生成几次
AGENT_MAX_REFLECT=1
# 关掉可省一次模型调用，但会失去 CRAG 的相关性过滤能力
AGENT_GRADING_ENABLED=true
# sqlite = 图状态持久化（可按 trace 回溯）; memory = 只在进程内
AGENT_CHECKPOINT_BACKEND=sqlite

# ---------------------------------- 会话记忆 ----------------------------------
# 双重截断：轮数 + 字符预算，取更严者
MEMORY_MAX_TURNS=6
MEMORY_MAX_CHARS=4000

# ------------------------------------ 上传 ------------------------------------
MAX_UPLOAD_MB=20
ALLOWED_EXTENSIONS=md,markdown,txt,pdf,csv,json

# ------------------------------------ 日志 ------------------------------------
LOG_LEVEL=INFO
# true = JSON 输出（生产，可直接进 ELK/Loki）; false = 本地彩色
LOG_JSON=false

# ------------------------------------ 限流 ------------------------------------
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=60

# ---------------------------------- 成本核算 ----------------------------------
# USD / 1K tokens，参考价，仅用于量级估算
PRICING_PROMPT_PER_1K=0.00014
PRICING_COMPLETION_PER_1K=0.00028
USD_TO_CNY=7.2

# -------------------------------- 模型下载镜像 --------------------------------
# 国内下载 HuggingFace 模型用镜像
HF_ENDPOINT=https://hf-mirror.com
